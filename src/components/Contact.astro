---
import Ornament from "./Ornament.astro";
import ArabicWordmark from "./ArabicWordmark.astro";
// Social links weren't set in Framer yet — fill these in.
const elsewhere = [
  ["SoundCloud", "https://soundcloud.com/nahawandi"],
  ["Instagram", "#"],
  ["Resident Advisor", "#"],
];
---
<section class="contact" id="contact">
  <span class="big-rosette"><Ornament kind="big-rosette" size={150} opacity={0.14} class="spin-slow" /></span>
  <div class="wrap">
    <div class="contact-label reveal">
      <Ornament kind="dot" size={8} opacity={0.7} />
      <span class="label">CONTACT &amp; BOOKING</span>
      <span class="arabic muted">تواصل</span>
    </div>
    <div class="contact-cols">
      <div class="reveal" style="--d:.1s">
        <span class="label col-label">EMAIL</span>
        <a class="mail" href="mailto:booking@nahawandi.com">booking@nahawandi.com</a>
        <a class="mail" href="mailto:info@nahawandi.com">info@nahawandi.com</a>
      </div>
      <div class="reveal" style="--d:.2s">
        <span class="label col-label">ELSEWHERE</span>
        <div class="elsewhere">
          {elsewhere.map(([name, href]) => (
            <a href={href} target="_blank" rel="noopener">{name} ↗</a>
          ))}
        </div>
      </div>
    </div>
    <footer class="footer reveal-fade">
      <div class="marks">
        <span class="wordmark">NAHAWANDI</span>
        <ArabicWordmark width={84} />
      </div>
      <div class="starband">
        <Ornament kind="dot" size={5} opacity={0.4} />
        <Ornament kind="star" size={14} opacity={0.7} />
        <Ornament kind="dot" size={5} opacity={0.4} />
      </div>
      <span class="label muted">© 2026 · NAHAWANDI.COM</span>
    </footer>
  </div>
</section>
