---
// Line icons drawn as SVG so phones never swap them for colour emoji.
type Name = "play" | "arrow-down" | "arrow-up-right" | "arrow-left" | "note" | "prev" | "next" | "close" | "volume" | "mute" | "spotify" | "soundcloud" | "applemusic";
const { name, size = 14, class: cls = "" } = Astro.props as { name: Name; size?: number; class?: string };
---
<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 16 16" aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  {name === "play" && <path d="M5 3.2v9.6L12.6 8z" fill="currentColor" stroke="none" />}
  {name === "arrow-down" && <path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" />}
  {name === "arrow-up-right" && <path d="M4.5 11.5l7-7M5.5 4.5h6v6" />}
  {name === "arrow-left" && <path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5" />}
  {name === "prev" && <><path d="M12.5 3.5v9L6 8z" fill="currentColor" stroke="none" /><path d="M4 3.5v9" /></>}
  {name === "next" && <><path d="M3.5 3.5v9L10 8z" fill="currentColor" stroke="none" /><path d="M12 3.5v9" /></>}
  {name === "close" && <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" />}
  {name === "volume" && <><path d="M2.5 6.2v3.6h2.3L8 12.5v-9L4.8 6.2z" fill="currentColor" stroke="none" /><path d="M10.4 5.8a3.1 3.1 0 0 1 0 4.4M12.2 4a5.6 5.6 0 0 1 0 8" /></>}
  {name === "mute" && <><path d="M2.5 6.2v3.6h2.3L8 12.5v-9L4.8 6.2z" fill="currentColor" stroke="none" /><path d="M10.5 6.2l3.6 3.6M14.1 6.2l-3.6 3.6" /></>}
  {name === "spotify" && <><circle cx="8" cy="8" r="6.6" /><path d="M4.7 6.3c2.2-.7 4.7-.5 6.7.7M5.1 8.5c1.8-.5 3.7-.3 5.3.6M5.5 10.6c1.4-.4 2.8-.2 4 .5" /></>}
  {name === "soundcloud" && <path d="M1.3 9.6v1.9M3 8.4v3.1M4.7 7.4v4.1M6.4 6.2v5.3M8.1 11.5V4.9c2-.6 4 .7 4.5 2.8a1.9 1.9 0 0 1 .4 3.8z" />}
  {name === "applemusic" && <><rect x="1.6" y="1.6" width="12.8" height="12.8" rx="3.4" /><path d="M6.6 10.6V5.4l4-1v5" /><circle cx="5.4" cy="10.6" r="1.2" /><circle cx="9.4" cy="9.4" r="1.2" /></>}
  {name === "note" && <path d="M6 12.2V3.6l7-1.4v8.6M6 12.2a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0zM13 10.8a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0z" />}
</svg>
