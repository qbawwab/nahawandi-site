---
/**
 * Inline SoundCloud player (official widget iframe). When `start` is given
 * ("m:ss" or "h:mm:ss") the first press of play jumps to that point. With
 * `lazy`, the iframe is only created when the element is activated (used by
 * the track rows so 21 players don't load at once).
 *
 * Only one thing plays at a time: every player (and the mini player in
 * TrackBrowser) announces "nah:play" and pauses when someone else does.
 */
interface Props { url: string; start?: string; lazy?: boolean; color?: string; title?: string }
const { url, start = "", lazy = false, color = "#000000", title = "" } = Astro.props;
const src =
  "https://w.soundcloud.com/player/?url=" + encodeURIComponent(url) +
  "&color=" + encodeURIComponent(color) +
  "&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&visual=false";
---
<sc-player class="sc-box" data-src={src} data-start={start} data-lazy={lazy ? "1" : ""} data-title={title}></sc-player>

<script>
  const toMs = (t: string) => {
    if (!t) return 0;
    const parts = t.split(":").map(Number);
    if (parts.some(isNaN)) return 0;
    return parts.reduce((acc, n) => acc * 60 + n, 0) * 1000;
  };

  const loadApi = (): Promise<any> =>
    ((window as any).__scApi ??= new Promise((resolve) => {
      if ((window as any).SC?.Widget) return resolve((window as any).SC);
      const s = document.createElement("script");
      s.src = "https://w.soundcloud.com/player/api.js";
      s.onload = () => resolve((window as any).SC);
      document.head.appendChild(s);
    }));

  class SCPlayer extends HTMLElement {
    mounted = false;
    playing = false;
    widget: any = null;

    connectedCallback() {
      if (!this.dataset.lazy) this.mount();
      window.addEventListener("nah:play", (e) => {
        if ((e as CustomEvent).detail !== this && this.playing) this.pause();
      });
    }

    mount() {
      if (this.mounted) return;
      this.mounted = true;
      const iframe = document.createElement("iframe");
      iframe.src = this.dataset.src!;
      iframe.allow = "autoplay";
      iframe.loading = "lazy";
      iframe.title = "SoundCloud player";
      this.appendChild(iframe);

      const startMs = toMs(this.dataset.start || "");
      loadApi().then((SC) => {
        const widget = (this.widget = SC.Widget(iframe));
        let seeked = !startMs;
        widget.bind(SC.Widget.Events.PLAY, () => {
          this.playing = true;
          window.dispatchEvent(new CustomEvent("nah:play", { detail: this }));
          if (!seeked) {
            seeked = true;
            widget.seekTo(startMs);
          }
        });
        widget.bind(SC.Widget.Events.PAUSE, () => (this.playing = false));
        widget.bind(SC.Widget.Events.FINISH, () => (this.playing = false));
      });
    }

    pause() {
      this.playing = false;
      this.widget?.pause();
    }

    /** Current position in ms (0 if not ready). */
    position(): Promise<number> {
      return new Promise((resolve) => (this.widget ? this.widget.getPosition(resolve) : resolve(0)));
    }
  }
  if (!customElements.get("sc-player")) customElements.define("sc-player", SCPlayer);
</script>
