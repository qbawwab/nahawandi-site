---
import { tracks, chapters, biNum } from "../data/tracks";
import SoundCloud from "./SoundCloud.astro";
import Icon from "./Icon.astro";

const VISIBLE = 6; // rows shown before "More tracks"
const counts = Object.fromEntries(
  chapters.map((c) => [c.id, c.id === "all" ? tracks.length : tracks.filter((t) => t.categories.includes(c.id as any)).length]),
);
---
<div class="track-browser" data-visible={VISIBLE}>
  <div class="tabs reveal" role="tablist" aria-label="Chapters">
    {chapters.map((c, i) => (
      <button class="tab" role="tab" data-chapter={c.id} aria-selected={i === 0 ? "true" : "false"}>
        <span class="label">{biNum(i)}</span>
        <span class="tab-name">{c.label}</span>
        <span class="count muted">({counts[c.id]})</span>
      </button>
    ))}
  </div>

  <ol class="track-list" style="list-style:none;margin:0;padding:0">
    {tracks.map((t, i) => (
      <li class="track" data-cats={t.categories.join(" ")} data-url={t.soundcloud} data-start={t.start ?? ""} data-title={t.title}>
        <button class="track-head" aria-expanded="false">
          <span class="label track-num">{biNum(i + 1)}</span>
          <span class="track-title">{t.title}</span>
          <span class="track-meta">
            <span class="label">{t.source}</span>
            <span class="label">{t.chapter ?? t.categories.map((c) => c.toUpperCase()).join(" / ")}</span>
            <span class="label">{t.duration}</span>
          </span>
          <span class="track-toggle" aria-hidden="true">+</span>
        </button>
        <div class="track-body">
          <div>
            <div class="track-details">
              {t.artwork
                ? <div class="artwork" style={`background-image:url(${t.artwork})`}></div>
                : <div class="artwork"><span>ARTWORK PLACEHOLDER</span></div>}
              <div class="track-info">
                <p class="desc">{t.description}</p>
                <SoundCloud url={t.soundcloud} start={t.start} title={t.title} lazy />
                <button type="button" class="btn-line mini-play">
                  <Icon name="play" size={12} /><span class="mp-go">PLAY IN MINI PLAYER</span><span class="mp-now">NOW PLAYING</span>
                </button>
                <div class="track-actions">
                  {t.spotify && (
                    <a class="btn-line" href={t.spotify} target="_blank" rel="noopener">
                      <Icon name="note" size={14} /> SPOTIFY
                    </a>
                  )}
                  {t.note && <span class="label muted">{t.note}</span>}
                </div>
              </div>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <div class="more-wrap">
    <button class="btn-outline more-btn" aria-expanded="false">
      <span class="more-label">MORE TRACKS</span><span class="more-icon"><Icon name="arrow-down" size={13} /></span>
    </button>
  </div>

  <!-- Mini player: opens when a playing track is closed, then stays until the visitor closes it -->
  <div class="mini" hidden aria-label="Mini player">
    <div class="mini-head">
      <span class="mini-label">NOW PLAYING</span>
      <span class="mini-title"></span>
      <div class="mini-ctrls">
        <button type="button" class="mini-btn mini-prev" aria-label="Previous track"><Icon name="prev" size={13} /></button>
        <button type="button" class="mini-btn mini-next" aria-label="Next track"><Icon name="next" size={13} /></button>
        <button type="button" class="mini-btn mini-close" aria-label="Stop and close player"><Icon name="close" size={13} /></button>
      </div>
    </div>
    <div class="mini-frame"></div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".track-browser").forEach((root) => {
    const visible = Number(root.dataset.visible || 6);
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(".tab")];
    const rows = [...root.querySelectorAll<HTMLLIElement>(".track")];
    const moreWrap = root.querySelector<HTMLElement>(".more-wrap")!;
    const moreBtn = root.querySelector<HTMLButtonElement>(".more-btn")!;
    let chapter = "all";
    let expanded = false;

    const render = () => {
      let shown = 0;
      for (const row of rows) {
        const match = chapter === "all" || (row.dataset.cats || "").split(" ").includes(chapter);
        row.hidden = !match;
        row.classList.remove("extra", "collapsed");
        if (match) {
          shown++;
          if (shown > visible) row.classList.add("extra", ...(expanded ? [] : ["collapsed"]));
        }
      }
      moreWrap.hidden = shown <= visible;
      moreBtn.setAttribute("aria-expanded", String(expanded));
      moreBtn.querySelector(".more-label")!.textContent = expanded ? "FEWER TRACKS" : `MORE TRACKS (${shown - visible})`;
      moreBtn.classList.toggle("is-open", expanded);
    };

    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        chapter = tab.dataset.chapter!;
        expanded = false;
        tabs.forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
        render();
      }),
    );

    moreBtn.addEventListener("click", () => {
      expanded = !expanded;
      render();
      if (!expanded) root.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    // ───── Mini player ─────
    const toMs = (t: string) => {
      if (!t) return 0;
      const parts = t.split(":").map(Number);
      return parts.some(isNaN) ? 0 : parts.reduce((acc, n) => acc * 60 + n, 0) * 1000;
    };
    const loadApi = (): Promise<any> =>
      ((window as any).__scApi ??= new Promise((resolve) => {
        if ((window as any).SC?.Widget) return resolve((window as any).SC);
        const s = document.createElement("script");
        s.src = "https://w.soundcloud.com/player/api.js";
        s.onload = () => resolve((window as any).SC);
        document.head.appendChild(s);
      }));
    const OPTS = { color: "#000000", hide_related: true, show_comments: false, show_user: true, show_reposts: false, show_teaser: false, visual: false };
    const widgetSrc = (url: string) =>
      "https://w.soundcloud.com/player/?url=" + encodeURIComponent(url) + "&auto_play=true&" +
      Object.entries(OPTS).map(([k, v]) => `${k}=${encodeURIComponent(String(v))}`).join("&");

    const data = rows.map((r) => ({ url: r.dataset.url!, start: toMs(r.dataset.start || ""), title: r.dataset.title || "" }));
    const mini = root.querySelector<HTMLElement>(".mini")!;
    const miniTitle = mini.querySelector(".mini-title")!;
    const frame = mini.querySelector(".mini-frame")!;
    const MINI = "mini";
    let active = false; // mini player is open
    let widget: any = null;
    let loadedUrl = "";
    let current = -1;
    let pendingSeek: number | null = null;

    const markCurrent = (i: number) => {
      current = i;
      rows.forEach((r, j) => r.classList.toggle("is-current", j === i));
      miniTitle.textContent = data[i]?.title || "";
    };

    const setup = (url: string) =>
      loadApi().then((SC) => {
        const iframe = document.createElement("iframe");
        iframe.allow = "autoplay";
        iframe.title = "SoundCloud mini player";
        iframe.src = widgetSrc(url);
        frame.appendChild(iframe);
        widget = SC.Widget(iframe);
        widget.bind(SC.Widget.Events.PLAY, () => {
          window.dispatchEvent(new CustomEvent("nah:play", { detail: MINI }));
          if (pendingSeek) widget.seekTo(pendingSeek);
          pendingSeek = null;
        });
        // In a DJ set, follow the timestamps so the title matches what's playing.
        widget.bind(SC.Widget.Events.PLAY_PROGRESS, (e: any) => {
          if (pendingSeek !== null) return;
          const pos = e.currentPosition;
          let best = -1;
          data.forEach((d, j) => {
            if (d.url === loadedUrl && d.start <= pos + 500 && (best < 0 || d.start >= data[best].start)) best = j;
          });
          if (best >= 0 && best !== current) markCurrent(best);
        });
        widget.bind(SC.Widget.Events.FINISH, () => step(1));
      });

    /** Play track i in the mini player, from `ms` (defaults to its timestamp). */
    const playTrack = (i: number, ms = data[i].start) => {
      const d = data[i];
      markCurrent(i);
      if (!active) {
        active = true;
        mini.hidden = false;
        root.classList.add("mini-on");
      }
      if (!widget) {
        loadedUrl = d.url;
        pendingSeek = ms || null;
        setup(d.url);
      } else if (d.url === loadedUrl) {
        widget.seekTo(ms);
        widget.play();
      } else {
        loadedUrl = d.url;
        pendingSeek = ms || null;
        widget.load(d.url, { ...OPTS, auto_play: true });
      }
    };

    // Arrows move through the tracks of the current chapter tab, wrapping around.
    const step = (dir: 1 | -1) => {
      const list = rows.map((r, j) => (r.hidden ? -1 : j)).filter((j) => j >= 0);
      if (!list.length) return;
      const at = list.indexOf(current);
      const next = at < 0 ? list[0] : list[(at + dir + list.length) % list.length];
      playTrack(next);
    };

    mini.querySelector(".mini-prev")!.addEventListener("click", () => step(-1));
    mini.querySelector(".mini-next")!.addEventListener("click", () => step(1));
    mini.querySelector(".mini-close")!.addEventListener("click", () => {
      widget?.pause();
      active = false;
      mini.hidden = true;
      root.classList.remove("mini-on");
      markCurrent(-1);
      // an open row gets its own player back
      rows.forEach((r) => r.classList.contains("open") && (r.querySelector("sc-player") as any)?.mount?.());
    });
    // Another player (e.g. the featured mix) started: pause, but stay open.
    window.addEventListener("nah:play", (e) => {
      if ((e as CustomEvent).detail !== MINI) widget?.pause();
    });

    /** Move a playing inline player (a track row or the featured mix) into the mini player. */
    const handOver = (player: any) => {
      if (active || !player?.playing || player.handing) return;
      player.handing = true;
      player.position().then((ms: number) => {
        player.handing = false;
        if (active || !player.playing) return;
        const row = player.closest(".track") as HTMLLIElement | null;
        let i = row ? rows.indexOf(row) : -1;
        if (i < 0) {
          // featured mix: find the set track at this timestamp
          const url = new URL(player.dataset.src).searchParams.get("url");
          data.forEach((d, j) => {
            if (d.url === url && d.start <= ms + 500 && (i < 0 || d.start >= data[i].start)) i = j;
          });
        }
        if (i < 0) return;
        player.pause();
        playTrack(i, ms);
      });
    };

    // A playing track that scrolls off screen keeps going in the mini player.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (!e.isIntersecting) handOver(e.target);
    });
    document.querySelectorAll("sc-player").forEach((p) => io.observe(p));

    // ───── Rows ─────
    const closeRow = (row: HTMLLIElement) => {
      row.classList.remove("open");
      row.querySelector(".track-head")!.setAttribute("aria-expanded", "false");
      // A track that's playing when its row closes moves into the mini player.
      handOver(row.querySelector("sc-player"));
    };

    const openRow = (row: HTMLLIElement) => {
      row.classList.add("open");
      row.querySelector(".track-head")!.setAttribute("aria-expanded", "true");
      if (active) playTrack(rows.indexOf(row)); // mini player is open: switch to this track
      else (row.querySelector("sc-player") as any)?.mount?.();
    };

    rows.forEach((row, i) =>
      row.querySelector(".mini-play")!.addEventListener("click", () => playTrack(i)),
    );

    // One track open at a time.
    rows.forEach((row) => {
      row.querySelector(".track-head")!.addEventListener("click", () => {
        if (row.classList.contains("open")) return closeRow(row);
        rows.forEach((r) => r !== row && r.classList.contains("open") && closeRow(r));
        openRow(row);
      });
    });

    render();
  });
</script>
