---
/** Oriental star ornaments, taken from the Framer SVGs (viewBox 0 0 40 40, white). */
interface Props {
  kind: "dot" | "star" | "rosette" | "big-rosette";
  size: number;
  opacity?: number;
  class?: string;
  style?: string;
}
const { kind, size, opacity = 1, class: cls = "", style = "" } = Astro.props;
---
<svg
  class={`orn orn-${kind} ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  aria-hidden="true"
  style={`opacity:${opacity};${style}`}
>
  {kind === "dot" && (
    <g fill="#fff">
      <rect x="10" y="10" width="20" height="20" />
      <rect x="10" y="10" width="20" height="20" transform="rotate(45 20 20)" />
    </g>
  )}
  {kind === "star" && (
    <g fill="none" stroke="#fff" stroke-width="1.2">
      <rect x="10" y="10" width="20" height="20" />
      <rect x="10" y="10" width="20" height="20" transform="rotate(45 20 20)" />
      <circle cx="20" cy="20" r="3.5" />
    </g>
  )}
  {(kind === "rosette" || kind === "big-rosette") && (
    <g fill="none" stroke="#fff" stroke-width={kind === "rosette" ? 0.9 : 0.6}>
      <rect x="9" y="9" width="22" height="22" />
      <rect x="9" y="9" width="22" height="22" transform="rotate(22.5 20 20)" />
      <rect x="9" y="9" width="22" height="22" transform="rotate(45 20 20)" />
      <rect x="9" y="9" width="22" height="22" transform="rotate(67.5 20 20)" />
      <circle cx="20" cy="20" r="5" />
      {kind === "big-rosette" && <circle cx="20" cy="20" r="14.5" />}
      <circle cx="20" cy="20" r="1.6" fill="#fff" stroke="none" />
    </g>
  )}
</svg>
