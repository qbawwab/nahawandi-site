---
import Base from "../layouts/Base.astro";
import Ornament from "../components/Ornament.astro";
import ArabicWordmark from "../components/ArabicWordmark.astro";
import Divider from "../components/Divider.astro";
import SoundCloud from "../components/SoundCloud.astro";
import TrackBrowser from "../components/TrackBrowser.astro";
import Icon from "../components/Icon.astro";
// All copy, photos and dates are edited from /admin (files in src/data).
import site from "../data/site.json";
import gigData from "../data/gigs.json";

// Any field left empty in /admin is simply left out of the page.
const { hero = {}, sound = {}, about = {}, live = {} } = site as any;
const mix = sound.mix ?? {};
const links = (hero.links ?? []).filter((l: any) => l?.name && l?.url);
const gigs = ((gigData as any).gigs ?? []).filter((g: any) => g?.date || g?.name || g?.place);
// Platform icon for a listen link, picked from its name (other names get no icon).
const platformIcon = (name: string) =>
  /spotify/i.test(name) ? "spotify" : /soundcloud/i.test(name) ? "soundcloud" : /apple/i.test(name) ? "applemusic" : null;
---
<Base title={site.seoTitle || "Nahawandi"} description={site.seoDescription || ""}>
  <!-- ───── Hero ───── -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-meta reveal-fade">
        <span class="side">{hero.tagLeft && <><Ornament kind="dot" size={8} opacity={0.7} /><span class="label">{hero.tagLeft}</span></>}</span>
        <span class="centre">
          <Ornament kind="star" size={14} opacity={0.7} />
          <ArabicWordmark width={106} />
          <Ornament kind="star" size={14} opacity={0.7} />
        </span>
        <span class="side">{hero.tagRight && <><span class="label">{hero.tagRight}</span><Ornament kind="dot" size={8} opacity={0.7} /></>}</span>
      </div>

      {links.length > 0 && <nav class="hero-listen reveal-fade" aria-label="Listen on">
        <div class="hero-listen-links">
          {links.map(({ name, url }: any) => {
            const brand = platformIcon(name);
            return (
              <a class="label" href={url} target="_blank" rel="noopener">
                {brand && <Icon name={brand} size={15} class="platform" />}{name} <Icon name="arrow-up-right" size={11} />
              </a>
            );
          })}
        </div>
      </nav>}

      <div class="hero-visual">
        {hero.image && <div class="hero-photo reveal">
          <img src={hero.image} alt="Nahawandi" fetchpriority="high" />
          <span class="inner-arch"></span>
        </div>}
        <div class="hero-stars" aria-hidden="true">
          <Ornament kind="star" size={18} class="twinkle" style="top:110px;left:70px;--o:.55" opacity={0.55} />
          <Ornament kind="dot" size={8} class="twinkle" style="top:250px;left:190px;--o:.6;--d:1.2s" opacity={0.6} />
          <Ornament kind="star" size={12} class="twinkle" style="top:380px;left:40px;--o:.35;--d:2s" opacity={0.35} />
          <Ornament kind="dot" size={6} class="twinkle" style="top:470px;left:150px;--o:.45;--d:.6s" opacity={0.45} />
          <span class="rot" style="position:absolute;top:170px;left:120px"><Ornament kind="rosette" size={34} opacity={0.3} class="spin" /></span>
        </div>
        <h1 class="hero-name wordmark words">NAHAWANDI</h1>
      </div>

      <div class="hero-bottom">
        {hero.copy ? <p class="hero-copy muted reveal" style="--d:.2s">{hero.copy}</p> : <span></span>}
        <div class="hero-cta reveal" style="--d:.35s">
          <a class="enter" href="#sound" aria-label={hero.cta || "Listen"}><span class="play-circle"><Icon name="play" size={18} /></span>{hero.cta}</a>
          <span class="label muted float scroll-hint">SCROLL <Icon name="arrow-down" size={12} /></span>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <!-- ───── Sound archive ───── -->
  <section class="sound" id="sound">
    <div class="wrap">
      <span class="big-rosette" aria-hidden="true"><Ornament kind="big-rosette" size={190} opacity={0.14} class="spin-slow" /></span>

      <div class="sound-intro">
        {sound.arabic && <span class="arabic reveal" style="--d:.05s">{sound.arabic}</span>}
        {sound.heading && <h2 class="words">{sound.heading}</h2>}
        {sound.intro && <p class="reveal" style="--d:.25s">{sound.intro}</p>}
      </div>

      <TrackBrowser />

      {(mix.soundcloud || mix.title) && <article class="liveset reveal">
        {(mix.eyebrow || mix.meta) && <div class="liveset-head">
          {mix.eyebrow ? <span class="liveset-tag"><span class="live-dot" aria-hidden="true"></span><span class="label">{mix.eyebrow}</span></span> : <span></span>}
          {mix.meta && <span class="label muted">{mix.meta}</span>}
        </div>}
        {mix.title && <h3>{mix.title}</h3>}
        {mix.soundcloud && <SoundCloud url={mix.soundcloud} title={mix.title || "Live set"} />}
      </article>}
    </div>
  </section>

  <Divider />

  <!-- ───── About ───── -->
  <section class="about" id="about" style="padding-top:120px">
    <div class="wrap">
      <div class="about-split">
        <div class="about-photo-col reveal">
          {about.image && <div class="arch-photo">
            <img src={about.image} alt="Qais — Nahawandi" loading="lazy" />
            <span class="inner-arch"></span>
          </div>}
          {(about.captionLeft || about.captionRight) && <div class="caption">
            <span class="label">{about.captionLeft}</span>
            <Ornament kind="star" size={13} opacity={0.6} />
            <span class="label">{about.captionRight}</span>
          </div>}
        </div>
        <div class="about-copy-col">
          <div class="about-header reveal-fade">
            <div class="row">
              <Ornament kind="dot" size={8} opacity={0.7} />
              <span class="label">ABOUT</span>
              <Ornament kind="star" size={13} opacity={0.6} />
              <span class="arabic">عن</span>
            </div>
            <div class="marks">
              <span class="wordmark">NAHAWANDI</span>
              <ArabicWordmark width={112} />
            </div>
          </div>
          <div class="about-copy">
            {about.heading && <h2 class="words">{about.heading}</h2>}
            {about.story && <p class="story reveal" style="--d:.1s">{about.story}</p>}
            {about.maqam && <p class="maqam reveal" style="--d:.2s">{about.maqam}</p>}
            {about.linkLabel && <a class="link-line reveal" style="--d:.3s" href="/biography/">{about.linkLabel}</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <!-- ───── Live (dates & bookings) ───── -->
  <section class="archive" id="live">
    <div class="wrap">
      <span class="bg-star" aria-hidden="true"><Ornament kind="star" size={70} opacity={0.12} class="spin-slow" /></span>
      <div class="archive-head">
        {live.heading ? <h2 class="display words">{live.heading}</h2> : <span></span>}
        {(live.arabic || live.label) && <div class="right reveal-fade">
          {live.arabic && <span class="arabic">{live.arabic}</span>}
          {live.arabic && live.label && <Ornament kind="star" size={13} opacity={0.6} />}
          {live.label && <span class="label">{live.label}</span>}
        </div>}
      </div>
      {gigs.map(({ date, name, place }: any, i: number) => (
        <div class="gig reveal" style={`--d:${i * 0.08}s`}>
          <span class="date">{date}</span>
          <span class="name">{name}</span>
          <span class="place">{place && <><Ornament kind="star" size={13} opacity={0.6} /><span class="label">{place}</span></>}</span>
        </div>
      ))}
      {(live.ctaText || live.ctaLabel) && <div class="live-cta reveal" style="--d:.2s">
        {live.ctaText && <p class="muted">{live.ctaText}</p>}
        {live.ctaLabel && <a class="link-line" href="#contact">{live.ctaLabel}</a>}
      </div>}
    </div>
  </section>

  <Divider bottom={90} />
</Base>
